# Copy to .env and fill in. Never commit .env.

# Discord bot token: Developer Portal -> your app -> Bot -> Reset Token
BOT_TOKEN=

# Optional: a server ID to register slash commands to instantly while developing.
# Leave empty to register global commands.
GUILD_ID=

# Optional: TMDB v3 API key or v4 read access token. Enables movies and shows.
TMDB_API_KEY=
